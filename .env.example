# Copy to .env to override defaults. All variables are optional.
RECSYS_DATABASE_URL=postgresql+psycopg2://recsys:recsys@localhost:5432/recsys
RECSYS_CACHE_BACKEND=memory        # memory | null | redis
RECSYS_REDIS_URL=redis://localhost:6379/0
RECSYS_CACHE_TTL_SECONDS=300
RECSYS_BATCH_K=20
RECSYS_HALF_LIFE_DAYS=120
